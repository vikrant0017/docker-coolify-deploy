# Copy to .env before running this app directly:
# cp .env.example .env

# Vite development API endpoint. The root development platform has API exposed here.
VITE_API_URL=http://localhost:4000

# Host port used by docker-compose.prod.yml.
WEB_PORT=8080

# Caddy's upstream for docker-compose.coolify.yml. The default preserves the
# local combined platform behavior. For separate Coolify resources use
# http://api-<api-resource-uuid>:4000.
API_UPSTREAM=http://api:4000
