# Coolify environment variables for the API resource.
# Replace this with a strong, unique password before pasting it into Coolify.
# Keep it private: it initializes Postgres and is also used by the API service.
API_DB_PASSWORD=replace-with-a-long-unique-password

# The default is http://todo-auth:4001. The auth service receives the
# todo-auth alias from docker-compose.coolify.yml on the external coolify network.
AUTH_SERVICE_URL=http://todo-auth:4001

# Optional. The web resource proxies /api through Caddy, so browser requests
# are same-origin and do not need CORS. Set this only if a browser calls the
# API directly, using that browser's exact origin:
# WEB_ORIGIN=http://todo.test
