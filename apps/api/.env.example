# Copy to .env before running this app directly:
# cp .env.example .env
#
# Local development values. Use a strong unique password and your public web
# origin when deploying docker-compose.prod.yml or the Coolify manifest.

# Required by docker-compose.prod.yml only; development uses its built-in demo DB password.
API_DB_PASSWORD=api-local-password

# Root platform/Coolify default when auth is available on the same Docker network.
# For separate Coolify resources use http://auth-<auth-resource-uuid>:4001.
AUTH_SERVICE_URL=http://auth:4001

# Local Vite development origin. Change to http://localhost:8080 for the local
# production-like stack, or https://todo.example.com for a Coolify deployment.
WEB_ORIGIN=http://localhost:5173
