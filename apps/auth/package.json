{
  "name": "todo-auth-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "bun src/server.ts",
    "start": "bun src/server.ts",
    "check": "bunx tsc --noEmit",
    "docker:up": "docker compose up --build",
    "docker:watch": "docker compose watch",
    "docker:restart": "docker compose restart auth",
    "docker:stop": "docker compose stop auth",
    "docker:start": "docker compose start auth",
    "docker:logs": "docker compose logs -f auth",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
