# Copy this file to .env before running the production-like Compose stack.
# Use long, unique values outside a local demo. Never commit the real .env file.
API_DB_PASSWORD=replace-with-a-long-random-api-database-password
AUTH_DB_PASSWORD=replace-with-a-long-random-auth-database-password

# Port exposed by Nginx. In a real deployment, use a reverse proxy or load balancer.
WEB_PORT=8080

# The browser origin permitted by the API. Use your HTTPS domain in production.
WEB_ORIGIN=http://localhost:8080
